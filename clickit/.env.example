# ClickIt local / production config
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8787

# mock | sony (sony stub until Camera Remote SDK is wired)
CAMERA_PROVIDER=mock

# local | s3 (s3 uses env credentials when implemented)
STORAGE_PROVIDER=local

# json (log to console/file) | smtp
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ClickIt <noreply@example.com>"

# Comma-separated admin token(s) for /api/admin/*
ADMIN_TOKENS=dev-admin-token

# Download link lifetime in hours
DOWNLOAD_LINK_HOURS=168

# Default booth settings (overridable via admin API / settings UI)
DEFAULT_COUNTDOWN_SECONDS=3
DEFAULT_PHOTO_COUNT=3
DEFAULT_INTERVAL_MS=1500
EVENT_NAME=ClickIt Event
